"""Type stub for python-flint. Covers only the API used in this project."""

from typing import Union, overload
from collections.abc import Iterable

Number = Union[int, float, str, arb, fmpq]
ComplexNumber = Union[int, float, complex, str, arb, acb, fmpq]

class fmpq:
    def __init__(self, numerator: int = 0, denominator: int = 1) -> None: ...

class fmpz:
    def __init__(self, value: int = 0) -> None: ...
    def is_prime(self) -> int: ...
    def __int__(self) -> int: ...
    def __sub__(self, other: fmpz) -> fmpz: ...

class fmpz_poly:
    def __init__(self, coefficients: list[int]) -> None: ...
    def __getitem__(self, index: int) -> fmpz: ...
    def __mul__(self, other: fmpz_poly) -> fmpz_poly: ...

class arb:
    real: arb
    imag: arb
    @overload
    def __init__(self, value: Number = 0) -> None: ...
    @overload
    def __init__(self, value: complex) -> None: ...
    @staticmethod
    def pi() -> arb: ...
    def floor(self) -> arb: ...
    def ceil(self) -> arb: ...
    def mid(self) -> arb: ...
    def abs_upper(self) -> arb: ...
    def abs_lower(self) -> arb: ...
    def unique_fmpz(self) -> fmpz | None: ...
    def sqrt(self) -> arb: ...
    def log(self) -> arb: ...
    def log_base(self, base: Number) -> arb: ...
    def __abs__(self) -> arb: ...
    def __add__(self, other: Number) -> arb: ...
    def __radd__(self, other: Number) -> arb: ...
    def __sub__(self, other: Number) -> arb: ...
    def __rsub__(self, other: Number) -> arb: ...
    def __mul__(self, other: Number) -> arb: ...
    def __rmul__(self, other: Number) -> arb: ...
    def __truediv__(self, other: Number) -> arb: ...
    def __rtruediv__(self, other: Number) -> arb: ...
    def __pow__(self, other: Number) -> arb: ...
    def __rpow__(self, other: Number) -> arb: ...
    def __neg__(self) -> arb: ...
    def __lt__(self, other: Number) -> bool: ...
    def __le__(self, other: Number) -> bool: ...
    def __gt__(self, other: Number) -> bool: ...
    def __ge__(self, other: Number) -> bool: ...
    def __float__(self) -> float: ...

class acb:
    real: arb
    imag: arb
    @overload
    def __init__(self, real: ComplexNumber = 0) -> None: ...
    @overload
    def __init__(self, real: Number, imag: Number) -> None: ...
    @staticmethod
    def dft(vec: Iterable[ComplexNumber], inverse: bool = False) -> list[acb]: ...
    def exp(self) -> acb: ...
    def conjugate(self, exact: bool = False) -> acb: ...
    def abs_upper(self) -> arb: ...
    def abs_lower(self) -> arb: ...
    def mid(self) -> acb: ...
    def __abs__(self) -> arb: ...
    def __add__(self, other: ComplexNumber) -> acb: ...
    def __radd__(self, other: ComplexNumber) -> acb: ...
    def __sub__(self, other: ComplexNumber) -> acb: ...
    def __rsub__(self, other: ComplexNumber) -> acb: ...
    def __mul__(self, other: ComplexNumber) -> acb: ...
    def __rmul__(self, other: ComplexNumber) -> acb: ...
    def __truediv__(self, other: ComplexNumber) -> acb: ...
    def __rtruediv__(self, other: ComplexNumber) -> acb: ...
    def __neg__(self) -> acb: ...
    def exp_pi_i(self) -> acb: ...

class FlintContext:
    prec: int

ctx: FlintContext
